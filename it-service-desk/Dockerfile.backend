# Dockerfile.backend
FROM python:3.9-slim

# Установка рабочей директории
WORKDIR /app

# Установка зависимостей для сборки
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    gcc \
    curl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Копирование файлов зависимостей
COPY requirements.txt .

# Установка зависимостей Python
RUN pip install --no-cache-dir -r requirements.txt

# Копирование исходного кода приложения
COPY . .

# Создание директорий для данных и логов
RUN mkdir -p /app/data /app/logs /app/uploads \
    && chmod -R 755 /app/data /app/logs /app/uploads

# Настройка переменных окружения
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    FLASK_APP=app.py \
    FLASK_ENV=production \
    GUNICORN_WORKERS=4 \
    GUNICORN_THREADS=2 \
    GUNICORN_TIMEOUT=120 \
    GUNICORN_KEEP_ALIVE=5 \
    GUNICORN_LOG_LEVEL=info

# Проверка здоровья приложения
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:5000/api/health || exit 1

# Открытие порта для приложения
EXPOSE 5000

# Запуск приложения через Gunicorn
CMD ["sh", "-c", "gunicorn --bind 0.0.0.0:5000 --workers ${GUNICORN_WORKERS} --threads ${GUNICORN_THREADS} --timeout ${GUNICORN_TIMEOUT} --keep-alive ${GUNICORN_KEEP_ALIVE} --log-level ${GUNICORN_LOG_LEVEL} --access-logfile - --error-logfile - wsgi:app"]