# IT Service Desk Frontend - Environment Variables Example

# API Configuration
REACT_APP_API_URL=http://localhost:5000/api
REACT_APP_API_TIMEOUT=30000

# Authentication
REACT_APP_AUTH_TOKEN_NAME=it_service_desk_token
REACT_APP_AUTH_REFRESH_TOKEN_NAME=it_service_desk_refresh_token
REACT_APP_AUTH_EXPIRY_NAME=it_service_desk_expiry
REACT_APP_AUTH_USER_INFO=it_service_desk_user

# Feature Flags
REACT_APP_FEATURE_NOTIFICATIONS=true
REACT_APP_FEATURE_ANALYTICS_DASHBOARD=true
REACT_APP_FEATURE_EQUIPMENT_MODULE=true
REACT_APP_FEATURE_REPORT_GENERATION=true

# UI Configuration
REACT_APP_THEME_PRIMARY_COLOR=#1976d2
REACT_APP_THEME_SECONDARY_COLOR=#dc004e
REACT_APP_THEME_MODE=light
REACT_APP_ROWS_PER_PAGE_OPTIONS=10,25,50,100
REACT_APP_DEFAULT_ROWS_PER_PAGE=25

# Notification Settings
REACT_APP_NOTIFICATION_AUTO_HIDE_DURATION=5000
REACT_APP_NOTIFICATION_POLLING_INTERVAL=60000
REACT_APP_MAX_NOTIFICATIONS_DISPLAY=5

# Dashboard Settings
REACT_APP_DASHBOARD_REFRESH_INTERVAL=300000
REACT_APP_DASHBOARD_CHARTS_ANIMATION=true

# Date & Time Format
REACT_APP_DATE_FORMAT=dd/MM/yyyy
REACT_APP_TIME_FORMAT=HH:mm
REACT_APP_DATETIME_FORMAT=dd/MM/yyyy HH:mm

# Logging
REACT_APP_LOG_LEVEL=error
REACT_APP_ENABLE_ERROR_REPORTING=false
REACT_APP_SENTRY_DSN=

# Performance
REACT_APP_ENABLE_QUERY_CACHE=true
REACT_APP_QUERY_CACHE_TIME=300000
REACT_APP_QUERY_STALE_TIME=240000
REACT_APP_QUERY_RETRY_COUNT=3

# File Upload
REACT_APP_MAX_FILE_SIZE=16777216
REACT_APP_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/plain

# Pagination
REACT_APP_PAGINATION_DEFAULT_PAGE=1
REACT_APP_PAGINATION_DEFAULT_SIZE=25

# Incident Settings
REACT_APP_INCIDENT_PRIORITY_COLORS={"low":"#4caf50","medium":"#ff9800","high":"#f44336","critical":"#9c27b0"}
REACT_APP_INCIDENT_STATUS_COLORS={"new":"#2196f3","in_progress":"#ff9800","on_hold":"#9e9e9e","resolved":"#4caf50","closed":"#000000"}

# Equipment Settings
REACT_APP_EQUIPMENT_STATUS_COLORS={"available":"#4caf50","in_use":"#2196f3","maintenance":"#ff9800","retired":"#9e9e9e"}

# Security
REACT_APP_ENABLE_CSP=true
REACT_APP_ENABLE_XSS_PROTECTION=true

# Internationalization
REACT_APP_DEFAULT_LANGUAGE=en
REACT_APP_SUPPORTED_LANGUAGES=en,fr,es,de

# PWA Settings
REACT_APP_ENABLE_SERVICE_WORKER=false

# Analytics
REACT_APP_ENABLE_ANALYTICS=false
REACT_APP_GOOGLE_ANALYTICS_ID=

# Development Tools
REACT_APP_ENABLE_REACT_QUERY_DEVTOOLS=false
REACT_APP_ENABLE_REDUX_DEVTOOLS=false

# Build Configuration
GENERATE_SOURCEMAP=false
SKIP_PREFLIGHT_CHECK=false
DISABLE_ESLINT_PLUGIN=false
TSC_COMPILE_ON_ERROR=false
ESLINT_NO_DEV_ERRORS=false

# Proxy Configuration (for local development)
REACT_APP_PROXY_TARGET=http://localhost:5000
REACT_APP_PROXY_SECURE=false
REACT_APP_PROXY_WS=true

# Session Settings
REACT_APP_SESSION_TIMEOUT_WARNING=300000
REACT_APP_SESSION_TIMEOUT=600000
REACT_APP_ENABLE_SESSION_TIMEOUT=true

# Custom Branding
REACT_APP_COMPANY_NAME=Your Company
REACT_APP_LOGO_URL=/logo.png
REACT_APP_FAVICON_URL=/favicon.ico