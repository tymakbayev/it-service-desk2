# IT Service Desk - Backend Environment Variables Example

# Application Settings
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000
SECRET_KEY=change_this_to_a_secure_random_string_in_production
APP_NAME=IT Service Desk

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/it_service_desk
SQLALCHEMY_TRACK_MODIFICATIONS=False
SQLALCHEMY_ECHO=False
AUTO_MIGRATE=True

# JWT Authentication
JWT_SECRET_KEY=change_this_to_a_secure_random_string_in_production
JWT_ACCESS_TOKEN_EXPIRATION=3600  # 1 hour in seconds
JWT_REFRESH_TOKEN_EXPIRATION=2592000  # 30 days in seconds
JWT_BLACKLIST_ENABLED=True

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# File Upload Settings
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216  # 16MB in bytes

# Email Configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_DEFAULT_SENDER=noreply@itservicedesk.com

# Redis and Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Default Admin User (created on first run)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin_password_change_me
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User

# Security Settings
PASSWORD_SALT=change_this_to_a_secure_random_string
BCRYPT_LOG_ROUNDS=12

# Analytics and Reporting
REPORT_EXPORT_PATH=exports/reports
TEMP_FILES_PATH=temp

# Notification Settings
ENABLE_EMAIL_NOTIFICATIONS=True
ENABLE_IN_APP_NOTIFICATIONS=True
NOTIFICATION_CLEANUP_DAYS=30  # Delete notifications older than 30 days

# Rate Limiting
RATELIMIT_ENABLED=True
RATELIMIT_DEFAULT=200 per day;50 per hour;10 per minute

# Feature Flags
FEATURE_EQUIPMENT_MODULE=True
FEATURE_ANALYTICS_DASHBOARD=True
FEATURE_REPORT_GENERATION=True
FEATURE_USER_MANAGEMENT=True

# Third-party Integrations
# Add any API keys or credentials for external services here
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
# JIRA_API_KEY=your_jira_api_key
# JIRA_URL=https://your-domain.atlassian.net