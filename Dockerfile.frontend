# Dockerfile.frontend
FROM node:16-alpine as build

# Установка рабочей директории
WORKDIR /app

# Установка зависимостей для сборки
RUN apk add --no-cache python3 make g++ git

# Аргументы сборки
ARG REACT_APP_API_BASE_URL=http://localhost:5000/api
ARG NODE_ENV=production

# Установка переменных окружения
ENV REACT_APP_API_BASE_URL=$REACT_APP_API_BASE_URL \
    NODE_ENV=$NODE_ENV \
    PATH=/app/node_modules/.bin:$PATH

# Копирование package.json и package-lock.json
COPY package.json package-lock.json ./

# Установка зависимостей
RUN npm ci --silent

# Копирование исходного кода приложения
COPY . .

# Сборка приложения
RUN npm run build

# Вторая стадия - создание production образа
FROM nginx:alpine

# Копирование конфигурации nginx
COPY nginx/nginx.conf /etc/nginx/conf.d/default.conf

# Копирование собранного приложения из стадии сборки
COPY --from=build /app/build /usr/share/nginx/html

# Создание директорий для данных и логов
RUN mkdir -p /var/log/nginx /var/cache/nginx && \
    chmod -R 755 /var/log/nginx /var/cache/nginx

# Настройка переменных окружения для nginx
ENV NGINX_ENTRYPOINT_QUIET_LOGS=1

# Проверка здоровья приложения
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget -q --spider http://localhost:80/ || exit 1

# Открытие порта для приложения
EXPOSE 80

# Запуск nginx в foreground режиме
CMD ["nginx", "-g", "daemon off;"]